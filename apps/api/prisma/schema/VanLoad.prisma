model VanLoad {
    id        String   @id @default(cuid())
    date      DateTime
    vehicleNo String
    companyId String
    company   Company  @relation(fields: [companyId], references: [id])

    loadItems VanLoadItem[]
}

model VanLoadItem {
    id        String @id @default(cuid())
    vanLoadId String
    itemId    String
    quantity  Int

    vanLoad VanLoad @relation(fields: [vanLoadId], references: [id])
    item    Item    @relation(fields: [itemId], references: [id])
}
