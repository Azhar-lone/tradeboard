enum Role {
  SUPER_USER
  COMPANY_ADMIN
  MANAGER
  STAFF
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  userName     String   @unique
  profileImage String?  @default("/profile.png")
  role         Role     @default(STAFF)
  company      Company? @relation(fields: [companyId], references: [id])
  companyId    Int?
}
