enum Role {
  SUPER_USER
  COMPANY_ADMIN
  MANAGER
  STAFF
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String
  userName       String    @unique
  FirstName      String
  lastName       String
  profileImage   String?   @default("/userProfile.jpg")
  role           Role      @default(STAFF)
  ownedCompanies Company[] @relation("CompanyOwners")
  companies      Company[] @relation("CompanyUsers")
}
