enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  MANAGER
  STAFF
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  userName  String   @unique
  role      Role     @default(STAFF)
  company   Company? @relation(fields: [companyId], references: [id])
  companyId Int?
}
