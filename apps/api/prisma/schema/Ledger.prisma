model Ledger {
  id          String     @id @default(cuid())
  type        LedgerType
  amount      Float
  createdAt   DateTime   @default(now())
  description String?

  companyId Int
  company   Company   @relation(fields: [companyId], references: [id])
  Invoice   Invoice[]
}

enum LedgerType {
  CREDIT
  DEBIT
}
